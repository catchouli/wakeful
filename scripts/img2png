#!/bin/sh
# img2png — convert an image in any readable format to PNG.
#
# Usage: img2png <input> [output.png]
#
# Output defaults to the input name with a .png extension, next to the
# input file. Pillow (Python) is tried first for color/palette fidelity;
# ffmpeg is the fallback for formats Pillow can't read (some DDS/TIFF
# variants and other exotics).
set -eu

if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
    echo "usage: img2png <input> [output.png]" >&2
    exit 2
fi

in=$1
if [ "$#" -eq 2 ]; then
    out=$2
else
    out=${in%.*}.png
    if [ "$out" = "$in" ] || [ "$out.png" = "$in" ]; then
        echo "img2png: $in is already a PNG; pass an output path to re-encode it" >&2
        exit 1
    fi
fi

[ -f "$in" ] || { echo "img2png: no such file: $in" >&2; exit 1; }

convert_with_pillow() {
    python3 - "$in" "$out" <<'EOF'
import sys

from PIL import Image

src, dst = sys.argv[1], sys.argv[2]
img = Image.open(src)
# Modes PNG can't hold (CMYK, YCbCr, 32-bit ints, ...) become RGBA;
# palette, RGB(A), and grayscale variants save as-is.
if img.mode not in ("RGB", "RGBA", "L", "LA", "P", "1"):
    img = img.convert("RGBA")
img.save(dst, format="PNG")
EOF
}

convert_with_ffmpeg() {
    ffmpeg -y -loglevel error -i "$in" "$out"
}

if ! convert_with_pillow; then
    rm -f "$out"
    echo "img2png: Pillow failed on $in, falling back to ffmpeg" >&2
    convert_with_ffmpeg
fi

[ -f "$out" ] || { echo "img2png: conversion failed: $in" >&2; exit 1; }
echo "img2png: $in -> $out"
