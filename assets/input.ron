// Input bindings: which physical inputs fire which action.
//
// Actions are PlayStation-labeled (the game's internal vocabulary);
// values are bevy key names ("KeyZ", "ArrowUp"), mouse buttons
// ("MouseLeft"), or pad buttons ("cross"). Entries left out fall back
// to the built-in defaults below — delete this file to restore them.

(
    buttons: {
        "cross": ["KeyZ", "Enter", "cross"],
        "circle": ["KeyX", "circle"],
        "triangle": ["KeyI", "triangle"],
        "square": ["KeyC", "square"],
        "dpad_up": ["KeyW", "ArrowUp", "dpad_up"],
        "dpad_down": ["KeyS", "ArrowDown", "dpad_down"],
        "dpad_left": ["KeyA", "ArrowLeft", "dpad_left"],
        "dpad_right": ["KeyD", "ArrowRight", "dpad_right"],
        "l1": ["KeyQ", "l1"],
        "r1": ["KeyE", "r1"],
        "l2": ["l2"],
        "r2": ["ShiftLeft", "ShiftRight", "r2"],
        "l3": ["L3"],
        "r3": ["R3"],
        "start": ["KeyQ", "Start"],
        "select": ["KeyR", "Select"],
    },
)
