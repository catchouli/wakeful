// Global UI config. Colors are (r, g, b, a) floats; the bubble fill is
// a gradient between the four corners. Defaults match the classic
// white box with black text.
(
    bubble: (
        top_left: (1.0, 1.0, 1.0, 1.0),
        top_right: (1.0, 1.0, 1.0, 1.0),
        bottom_right: (1.0, 1.0, 1.0, 1.0),
        bottom_left: (1.0, 1.0, 1.0, 1.0),
        text: (0.0, 0.0, 0.0, 1.0),
    ),
)
