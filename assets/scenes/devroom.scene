(
    camera: (
        position: (0.0, 6.0, 9.0),
        target: (0.0, 0.0, 0.0),
        fov_degrees: 45.0,
    ),
    walkable: Some((
        origin: (-2.5, -2.5),
        cell_size: 1.0,
        cols: 5,
        rows: 5,
        // The player spawns at the center cell, so that one stays
        // walkable; blocked corners demo the clamping.
        cells: [
            false, true, true, true, true,
            true, true, true, true, true,
            true, true, true, true, true,
            true, true, true, true, true,
            true, true, true, true, false,
        ],
    )),
    character_model: None,
    background: None,
    // Test teleporter: walk right from the spawn point into the strip on
    // the grid's east edge to jump to room2. Its arrival in room2 lands
    // inside room2's return trigger: re-arm keeps it quiet until the
    // player leaves the region and re-enters. The x keeps the player's
    // body (radius 0.4) fully on the grid — closer to the edge and every
    // constrained move gets rejected, leaving the player stuck.
    teleporters: [
        (
            position: (2.0, 0.0),
            size: (0.8, 2.0),
            target: "scenes/room2.scene",
            arrival: (-2.05, 0.0),
        ),
    ],
)
